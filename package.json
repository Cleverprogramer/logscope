{
  "name": "logscope",
  "version": "0.1.0",
  "private": true,
  "description": "Terminal-based log analysis & observability toolkit",
  "workspaces": ["packages/*"],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "coverage": "bun test --coverage",
    "dev": "bun run packages/cli/src/index.ts",
    "demo:gif": "bun run scripts/capture-demo.ts",
    "perf:smoke": "bun run scripts/perf-smoke.ts",
    "quickstart": "bun run dev -- stats sample.log --top 5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "typescript": "^7.0.2"
  }
}
